{
  "name": "agent-wormhole",
  "version": "0.1.0",
  "description": "Move a coding session between Claude Code, Codex and opencode, and resume it on the other side.",
  "private": true,
  "type": "module",
  "bin": {
    "wormhole": "bin/wormhole.js",
    "wh": "bin/wormhole.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2",
    "coverage": "vitest run --maxWorkers=2 --coverage"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
