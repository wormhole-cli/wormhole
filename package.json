{
  "name": "@wormhole-cli/wormhole",
  "version": "0.1.0",
  "description": "Move a coding session between Claude Code, Codex and opencode, and resume it on the other side.",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "ai-agents",
    "coding-agent",
    "agent-session",
    "handoff",
    "session-transfer",
    "cli",
    "llm",
    "anthropic",
    "openai"
  ],
  "homepage": "https://wormhole-cli.github.io/",
  "bugs": {
    "url": "https://github.com/wormhole-cli/wormhole/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wormhole-cli/wormhole.git"
  },
  "license": "MIT",
  "author": "ashutosh091 (https://github.com/ashutosh091)",
  "type": "module",
  "bin": {
    "wormhole": "bin/wormhole.js",
    "wh": "bin/wormhole.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2",
    "coverage": "vitest run --maxWorkers=2 --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "cross-spawn": "^7.0.6",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
